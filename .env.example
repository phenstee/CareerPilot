POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot
DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@db:5432/careerpilot

# Use development locally. Production enables stricter configuration validation.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
APP_URL=http://localhost:3000
BETA_ACCESS_CODE=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REGISTRATION_RATE_LIMIT_COUNT=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_COUNT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
RESUME_UPLOAD_RATE_LIMIT_COUNT=10
RESUME_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=86400
# Total AI generation requests per authenticated user across all AI workflows.
AI_RATE_LIMIT_COUNT=20
AI_RATE_LIMIT_WINDOW_SECONDS=3600
# Total job-search requests per authenticated user across profile and prompt search.
JOB_SEARCH_RATE_LIMIT_COUNT=60
JOB_SEARCH_RATE_LIMIT_WINDOW_SECONDS=3600

# AI_PROVIDER=mock uses deterministic local data and requires no API key.
# AI_PROVIDER=openai uses the backend-only OPENAI_API_KEY. Never expose this as NEXT_PUBLIC_*.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=1
GREENHOUSE_BOARDS=

NEXT_PUBLIC_API_URL=http://localhost:8000
# Required during production frontend builds because Next.js rewrites are build-time config.
BACKEND_INTERNAL_URL=http://backend:8000

# Production notes:
# ENVIRONMENT=production
# JWT_SECRET=<long-random-secret-at-least-32-characters>
# AUTH_COOKIE_SECURE=true
# APP_URL=https://your-frontend.example
# CORS_ORIGINS=https://your-frontend.example
# NEXT_PUBLIC_API_URL=https://your-backend.example
# BACKEND_INTERNAL_URL=https://your-backend.example
